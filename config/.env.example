# ============================================================
# South Shore Sentiment Study — Environment Configuration
# ============================================================
# Copy this to .env and fill in values as needed.
# NEVER commit .env to version control.

# ── Optional: Reddit credentials (not required for PullPush/OldReddit) ──
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=SouthShoreSentimentStudy/1.0

# ── YouTube Data API v3 (enables YouTube collection) ──
# Get key at: https://console.cloud.google.com/apis/credentials
# Enable: YouTube Data API v3
# Free tier: 10,000 quota units/day
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── HuggingFace (optional — for gated models) ──
# HF_TOKEN=

# ── Paths (override config/settings.yaml defaults) ──
# DB_PATH=data/sentiment_study.duckdb
# RAW_DIR=data/raw
# PROCESSED_DIR=data/processed

# ── Streamlit ──
# STREAMLIT_PORT=8501

# ── Logging ──
LOG_LEVEL=INFO
LOG_FORMAT=json
